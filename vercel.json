{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web", "framework": "nextjs" },
    "api": {
      "root": "deploy/api",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": { "main.py": { "maxDuration": 300, "includeFiles": "../../apps/api/nexus/**" } }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/:path*", "destination": { "service": "web" } }
  ]
}
