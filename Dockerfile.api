FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/apps/api OMP_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
WORKDIR /app
COPY apps/api/requirements.lock.txt /app/requirements.lock.txt
RUN pip install --no-cache-dir -r requirements.lock.txt && useradd --create-home --uid 10001 nexus
COPY apps/api /app/apps/api
COPY scripts /app/scripts
COPY examples /app/examples
RUN mkdir -p /app/data && chown -R nexus:nexus /app
USER nexus
CMD ["python", "-m", "uvicorn", "nexus.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
