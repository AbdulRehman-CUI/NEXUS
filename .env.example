# Copy to .env at repository root. Never commit .env.
NEXUS_DATA_DIR=./data
# local rejects non-loopback clients/hosts; server requires accounts, CSRF and membership.
NEXUS_PROFILE=local
# Persistent BYOK requires a private 32-byte base64 AES master key outside NEXUS_DATA_DIR.
# Generate with: python scripts/manage_byok_key.py
# NEXUS_BYOK_MASTER_KEY_FILE=.secrets/byok-master.key
# Alternatively inject NEXUS_BYOK_MASTER_KEY through your deployment secret manager. Never set both.
NEXUS_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Keep true for TLS server deployments. False is only for explicit loopback HTTP testing.
NEXUS_SECURE_COOKIES=true
NEXUS_SESSION_HOURS=12
NEXUS_RATE_LIMIT_PER_MINUTE=120
NEXUS_LOGIN_LIMIT_PER_MINUTE=5
NEXUS_TELEMETRY_RETENTION_DAYS=7
NEXUS_ISOLATED_EXTRACTION=true
NEXUS_EXTRACTION_TIMEOUT_SECONDS=45
# Optional Tesseract/tessdata installation; never invoked unless enabled.
NEXUS_OCR_ENABLED=false
NEXUS_OCR_MAX_PAGES=20
NEXUS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# mock is an explicitly labelled extractive demo; groq enables real generation.
NEXUS_GENERATION_PROVIDER=mock
NEXUS_GENERATION_MODEL=llama-3.1-8b-instant
NEXUS_GROQ_API_KEY=
# Optional generation-only adapters. Enabling a key alone grants no consent.
NEXUS_OPENAI_API_KEY=
NEXUS_ANTHROPIC_API_KEY=
NEXUS_GOOGLE_API_KEY=
NEXUS_COMPATIBLE_API_KEY=
NEXUS_COMPATIBLE_BASE_URL=
NEXUS_PROVIDER_ALLOWED_ORIGINS=[]
# Operator gate, in addition to per-workspace consent and allow_paid. Empty means zero paid adapters enabled.
NEXUS_PAID_PROVIDER_ALLOWLIST=[]
NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Confirm your account/model is eligible for Groq's Free Plan before enabling.
NEXUS_FREE_TIER_CONFIRMED=false
NEXUS_EMBEDDING_PROVIDER=onnx
NEXUS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set a matching immutable model revision when choosing another embedding model.
NEXUS_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
NEXUS_EMBEDDING_DIMENSION=384
NEXUS_EMBEDDING_ONNX_FILE=onnx/model_quint8_avx2.onnx
NEXUS_MODEL_CACHE_DIR=./data/models
# Only permits downloads for an explicitly enabled optional cross-encoder.
NEXUS_RERANKER_ALLOW_DOWNLOAD=false
NEXUS_MAX_VAULT_FILES=2000
NEXUS_MAX_NOTE_BYTES=2000000
NEXUS_MAX_VAULT_BYTES=20000000
NEXUS_MAX_ZIP_RATIO=100
NEXUS_VAULT_EXCLUDES=["*.tmp","~*",".DS_Store"]
NEXUS_CHUNK_SIZE=700
NEXUS_CHUNK_OVERLAP=100
NEXUS_CONTEXT_BUDGET=4000
NEXUS_MAX_RETRIEVAL_RESULTS=5
NEXUS_MAX_UPLOAD_MB=20
NEXUS_MAX_SOURCE_CHARACTERS=2000000
NEXUS_MAX_PDF_PAGES=1000
NEXUS_MAX_QUEUED_JOBS=50
NEXUS_MAX_DISTANCE=0.85
# Browser API origin (public, never put keys here).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
